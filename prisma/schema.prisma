generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector(schema: "public")]
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  documents        Document[]
  learningSessions LearningSession[]
  learningUnits    LearningUnit[]
  progress         Progress[]
  sessions         Session[]
  learningAnalytics LearningAnalytics[]
  studyPatterns     StudyPattern[]
  topicMastery      TopicMastery[]
  assessments       Assessment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LearningSession {
  id              String               @id @default(cuid())
  title           String
  userId          String
  progress        Float                @default(0)
  concepts        Json[]
  status          String               @default("active")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  lastActiveAt    DateTime             @default(now())
  explanations    ConceptExplanation[]
  relations       ConceptRelation[]
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionConcepts SessionConcept[]
  documents       SessionDocument[]
  timeRecords     SessionTime[]        @relation("SessionTimeRecords")
  assessments     Assessment[]

  @@index([userId])
  @@index([lastActiveAt])
}

model SessionDocument {
  id                 String          @id @default(cuid())
  title              String
  content            String
  structuredContent  Json            @default("{}")
  index              Json
  metadata           Json?
  version            Int             @default(1)
  status             String          @default("pending")
  processingMetadata Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sessionId          String
  session            LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Document {
  id            String           @id @default(cuid())
  title         String
  content       String
  mimeType      String
  size          Int
  status        ProcessingStatus
  storageKey    String           @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  embeddings    Embedding[]
  learningUnits LearningUnit[]
}

model Embedding {
  id         String   @id @default(cuid())
  content    String
  documentId String
  createdAt  DateTime @default(now())
  vector     Float[]
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model LearningUnit {
  id            String     @id @default(cuid())
  title         String
  content       String
  order         Int
  difficulty    Int        @default(1)
  documentId    String
  userId        String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  description   String?
  estimatedTime Int        @default(30)
  objectives    String[]
  prerequisites String[]
  document      Document   @relation(fields: [documentId], references: [id])
  user          User       @relation(fields: [userId], references: [id])
  progress      Progress[]
  questions     Question[]

  @@unique([documentId, order])
}

model Question {
  id             String       @id @default(cuid())
  text           String
  type           QuestionType
  options        Json?
  explanation    String?
  learningUnitId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  learningUnit   LearningUnit @relation(fields: [learningUnitId], references: [id])
}

model Progress {
  id             String         @id @default(cuid())
  userId         String
  learningUnitId String
  status         ProgressStatus
  confidence     Int            @default(0)
  lastReviewed   DateTime       @default(now())
  nextReview     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  learningUnit   LearningUnit   @relation(fields: [learningUnitId], references: [id])
  user           User           @relation(fields: [userId], references: [id])

  @@unique([userId, learningUnitId])
}

model ConceptExplanation {
  id        String          @id @default(cuid())
  conceptId String
  layer     Int
  content   String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sessionId String
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([conceptId, layer, sessionId])
  @@index([conceptId])
  @@index([sessionId])
}

model ConceptRelation {
  id        String          @id @default(cuid())
  sourceId  String
  targetId  String
  type      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sessionId String
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId, type])
  @@index([sourceId])
  @@index([targetId])
  @@index([sessionId])
}

model Concept {
  id               String           @id @default(cuid())
  title            String
  content          String
  level            Int
  order            Int
  parentId         String?
  contentUuid      String           @unique @default(uuid())
  version          Int              @default(1)
  processingStatus String           @default("pending")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  parent           Concept?         @relation("ConceptHierarchy", fields: [parentId], references: [id])
  children         Concept[]        @relation("ConceptHierarchy")
  sessions         SessionConcept[]

  @@unique([title, level, order])
  @@index([parentId])
  @@index([contentUuid])
}

model SessionConcept {
  id        String          @id @default(cuid())
  sessionId String
  conceptId String
  progress  Float           @default(0)
  status    String          @default("not_started")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  concept   Concept         @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, conceptId])
  @@index([sessionId])
  @@index([conceptId])
}

model SessionTime {
  id        String          @id @default(cuid())
  sessionId String
  startTime DateTime        @default(now())
  endTime   DateTime?
  duration  Int?            @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  session   LearningSession @relation("SessionTimeRecords", fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([startTime])
  @@index([isActive])
}

model LearningAnalytics {
  id            String    @id @default(cuid())
  userId        String
  date          DateTime  @default(now())
  timeOfDay     Int       // Hour of day (0-23)
  sessionLength Int       // Duration in minutes
  completedUnits Int
  retentionScore Float?   // Based on review performance (0-100)
  focusScore    Float?    // Based on time spent actively learning (0-100)
  topicId       String?   // Optional reference to most studied topic
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([timeOfDay])
}

model StudyPattern {
  id            String    @id @default(cuid())
  userId        String
  dayOfWeek     Int       // 0-6 (Sunday-Saturday)
  hourOfDay     Int       // 0-23
  effectiveness Float     // 0-100 score based on completion and retention
  frequency     Int       // Number of times studied at this time
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayOfWeek, hourOfDay])
  @@index([userId])
  @@index([dayOfWeek, hourOfDay])
}

model TopicMastery {
  id            String    @id @default(cuid())
  userId        String
  topic         String    // Topic or concept area
  masteryLevel  Float     // 0-100
  attempts      Int       @default(0)
  successRate   Float     @default(0)
  lastReviewed  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic])
  @@index([userId])
  @@index([topic])
}

model Assessment {
  id            String      @id @default(cuid())
  sessionId     String
  userId        String
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  status        AssessmentStatus @default(IN_PROGRESS)
  questions     AssessmentQuestion[]
  results       AssessmentResult[]
  session       LearningSession @relation(fields: [sessionId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([sessionId])
  @@index([userId])
}

model AssessmentQuestion {
  id            String      @id @default(cuid())
  assessmentId  String
  text          String
  type          QuestionType
  options       String[]    @default([])
  correctAnswer String?
  explanation   String?
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  result        AssessmentResult?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([assessmentId])
}

model AssessmentResult {
  id            String      @id @default(cuid())
  assessmentId  String
  questionId    String      @unique
  userAnswer    String
  isCorrect     Boolean
  feedback      String
  confidenceScore Int
  assessment    Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question      AssessmentQuestion    @relation(fields: [questionId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([assessmentId])
}

enum QuestionType {
  MULTIPLE_CHOICE
  OPEN_ENDED
  TRUE_FALSE
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

enum AssessmentStatus {
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}
